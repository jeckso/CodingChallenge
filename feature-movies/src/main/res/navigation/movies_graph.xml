<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/movies_graph"
    app:startDestination="@id/moviesFragment">

    <fragment
        android:id="@+id/moviesFragment"
        android:name="app.bettermetesttask.movies.sections.MoviesFragment"
        tools:layout="@layout/movies_fragment">

        <deepLink app:uri="@string/movies_deep_link" />
        <action
            android:id="@+id/action_show_movie_details"
            app:destination="@id/movieDetailsBottomSheet" />
    </fragment>
    <dialog
        android:id="@+id/movieDetailsBottomSheet"
        android:name="app.bettermetesttask.movies.sections.details.MovieDetailsBottomSheet"
        android:label="MovieDetailsBottomSheet" />
</navigation>